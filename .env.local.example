# --- Auth.js (NextAuth v5) ---
# Generate a secret with: npx auth secret
AUTH_SECRET=
# Google OAuth credentials from Google Cloud Console (see README)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The single Google account allowed to sign in (this is your private dashboard)
ALLOWED_EMAIL=you@example.com
# Production only: set to your deployed URL so OAuth callbacks resolve correctly,
# e.g. https://investment.example.com . Leave unset for local dev.
# AUTH_URL=
# Set to true when deploying behind a custom domain / proxy (e.g. on Vercel).
# AUTH_TRUST_HOST=true

# --- Database (Neon / Vercel Postgres) ---
# Use the POOLED connection string (host contains "-pooler").
POSTGRES_URL=

# --- Cron authorization ---
# Any long random string. On Vercel, set this and cron jobs will send it as a
# Bearer token that the /api/prices/refresh route checks.
CRON_SECRET=
